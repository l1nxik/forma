{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forma",
        "width": 1240,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "backgroundColor": "#f5f5f5",
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
